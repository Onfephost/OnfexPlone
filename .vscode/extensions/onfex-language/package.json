{
  "name": "onfex-language",
  "displayName": "Onfex Language Support",
  "description": "Basic syntax highlighting for .onfex files in VS Code",
  "version": "0.0.1",
  "publisher": "local",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:onfex",
    "onCommand:onfex.runFile"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "onfex.runFile",
        "title": "Run Onfex File",
        "category": "Onfex"
      }
    ],
    "languages": [
      {
        "id": "onfex",
        "aliases": [
          "Onfex",
          "onfex"
        ],
        "extensions": [
          ".onfex"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "onfex",
        "scopeName": "source.onfex",
        "path": "./syntaxes/onfex.tmLanguage.json"
      }
    ]
  }
}
